# ============================================================
# Trading Assistant - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string

# LLM Provider — set ONE of the two API keys below.
# The app auto-detects which provider to use (OpenAI takes priority).

# OpenAI  (cheapest: gpt-4o-mini)
OPENAI_API_KEY=your-openai-key-here
MODEL=gpt-4o-mini

# Google Gemini (comment out OPENAI_API_KEY above to use Gemini instead)
# MODEL=gemini-2.5-flash-lite
GOOGLE_API_KEY=your-google-api-key-here

# Alpaca Broker API (Sandbox / Paper Trading)
APCA_BROKER_KEY_ID=your-alpaca-broker-key-here
APCA_BROKER_SECRET_KEY=your-alpaca-broker-secret-here

# Alpaca Data API (for market data: crypto quotes, stock bars, etc.)
APCA_API_KEY_ID=your-alpaca-data-key-here
APCA_API_SECRET_KEY=your-alpaca-data-secret-here

# Alpha Vantage (free tier: 25 requests/day)
ALPHA_VANTAGE_KEY=your-alpha-vantage-key-here

# NewsAPI
NEWS_KEY=your-newsapi-key-here
